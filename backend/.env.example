PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/daftarcha

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Payomchi SMS (https://api.payomchi.tj/api/v1)
PAYOMCHI_API_KEY=your_payomchi_key
PAYOMCHI_SENDER=Daftarcha
# Override only if endpoint differs from default
PAYOMCHI_BASE_URL=https://api.payomchi.tj/api/v1

# Telegram notifications (admin alerts for new billing requests)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
