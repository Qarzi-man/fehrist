PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/daftarcha

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Paymochi SMS
PAYMOCHI_API_KEY=your_paymochi_key
PAYMOCHI_SENDER=Daftarcha
# Override if Paymochi uses a different base URL (e.g. https://api.paymochi.com)
PAYMOCHI_BASE_URL=https://paymochi.com
